"labResults": [
  {% for entry in observations %}
    {% if entry.category[0].coding[0].code == "laboratory" -%}
	  {% if entry.component %}
	    {% for component in entry.component %}
		  {
			"order": {
			  "codings": [
				{% for coding in entry.code.coding %}
				  {
					{% include '_codableconcept' coding: coding -%}
				  }{% unless forloop.last %},{% endunless %}
				{% endfor %}
			  ],
			  {% assign textValue = entry.code.text | default: entry.code.coding[0].display | default: entry.code.coding[0].code %}
			  "text": "{% include 'json_escape' value: textValue %}"
			},
		    "test": {
			  "codings": [
			    {% for coding in component.code.coding %}
				  {
				    {% include '_codableconcept' coding: coding -%}
				  }{% unless forloop.last %},{% endunless %}
			    {% endfor %}
			  ],
			  "text": "{% include 'json_escape' value: component.code.text | default: component.code.coding[0].display | default: component.code.coding[0].code %}"
			},
			"labCategory": {
			  "codings": [
			    {% for coding in entry.category[0].coding %}
				  {
				    {% include '_codableconcept' coding: coding -%}
				  },
			    {% endfor %}
			  ],
			  {% assign categoryText = entry.category[0].text | default: entry.category[0].coding[0].display | default: entry.category[0].coding[0].code %}
			  "text": "{% include 'json_escape' value: categoryText %}"
			},
			{%- assign performerId =  entry.performer[0].identifier.value | default: entry.performer[0].reference -%}
			"performerIdentifier": "{% include 'json_escape' value: performerId %}",
			"performerName": "{{ entry.performer[0].display }}",
		    "issuedDateTime": "{{ entry.issued }}",
		    "performedDateTime": "{{ entry.effectiveDateTime | default: entry.effectivePeriod.start }}",

			{%- assign performingSiteRefOrg = null -%}
			{%- assign performingSiteTypeOrg =  entry.performer | where: "type", "Organization" | first -%}
			{% if performingSiteTypeOrg == nil %}
              {% for performer in entry.performer %}
		        {%- assign refPrefix = performer.reference | slice: 0, 12 | downcase -%}
			    {% if refPrefix == "organization" %}
		   	      {% assign performingSiteRefOrg = performer %}
				  {% break %}
			    {% endif %}
			  {% endfor %}
			{% endif %}
		    "performingSite": {
		      {% if performingSiteTypeOrg %}
			    "codings": [
		    	  {
				    {% include '_codableconcept' coding: performingSiteTypeOrg -%}
				    {% include '_codableconcept' coding: performingSiteRefOrg -%}
				  }
			    ],
			    "text": "{% include 'json_escape' value: performingSiteTypeOrg.display | default: performingSiteTypeOrg.code %}"
		      {% elsif performingSiteRefOrg %}
			    "codings": [
		    	  {
				    {% include '_codableconcept' coding: performingSiteRefOrg -%}
				  }
			    ],
			    "text": "{% include 'json_escape' value: performingSiteRefOrg.display | default: performingSiteRefOrg.code %}"
			  {% endif %}
		    },
			"referenceRange": "{% include 'json_escape' value: entry.referenceRange[0].text %}",
			"interpretation": {
			  "codings": [
			    {% for coding in entry.interpretation[0].coding %}
				  {
				    {% include '_codableconcept' coding: coding -%}
				  },
			    {% endfor %}
			  ],
			  {% assign interpretationText = entry.interpretation[0].text | default: entry.interpretation[0].coding[0].display | default: entry.interpretation[0].coding[0].code %}
			  "text": "{% include 'json_escape' value: interpretationText %}"
			},
		    "resultStatus": {
			  "codings": [
			    {
				  "system": "http://hl7.org/fhir/ValueSet/observation-status",
				  "code": "{{ entry.status }}",
				  "display": "{{ entry.status | capitalize }}"      
			    }
			  ],
			  "text": "{{ entry.status | capitalize }}"
		    },
		    {% include '_resultValue' component: component %}
		  },
		{% endfor %}
	  {% else %}
		{
		  {% for report in reports %}
			{% if report.category[0].coding[0].code == "LAB" -%}
			  {% for result in report.result %}
				{% assign obsRef1 = "Observation/" | append: entry.id %}
				{% assign obsRef2 = "urn:uuid:" | append: entry.id %}
				{% if result.reference == obsRef1 or result.reference == obsRef2 %}
				  "order": {
				    "codings": [
				      {% for testCode in report.code.coding %}
					    {
				  	      {% include '_codableconcept' coding: testCode -%}
				        },
				      {% endfor %}
				    ],
				    {% assign textValue = report.code.text | default: report.code.coding[0].display | default: report.code.coding[0].code %}
				    "text": "{% include 'json_escape' value: textValue %}"
			      },
				  "orderDate": "{{ report.issued }}",
			    {% endif %}
			  {% endfor %}
		    {% endif %}
	      {% endfor %}
	   	  "test": {
		    "codings": [
			  {% for coding in entry.code.coding %}
			    {
				  {% include '_codableconcept' coding: coding -%}
			    }{% unless forloop.last %},{% endunless %}
			  {% endfor %}
		    ],
		    {% assign textValue = entry.code.text | default: entry.code.coding[0].display | default: entry.code.coding[0].code %}
		    "text": "{% include 'json_escape' value: textValue %}"
		  },
		  "labCategory": {
		    "codings": [
			  {% for coding in entry.category[0].coding %}
				{
				  {% include '_codableconcept' coding: coding -%}
				},
			  {% endfor %}
			],
			{% assign categoryText = entry.category[0].text | default: entry.category[0].coding[0].display | default: entry.category[0].coding[0].code %}
			"text": "{% include 'json_escape' value: categoryText %}"
		  },
		  {%- assign performerId =  entry.performer[0].identifier.value | default: entry.performer[0].reference -%}
		  "performerIdentifier": "{% include 'json_escape' value: performerId %}",
		  "performerName": "{{ entry.performer[0].display }}",
		  "issuedDateTime": "{{ entry.issued }}",
		  "performedDateTime": "{{ entry.effectiveDateTime | default: entry.effectivePeriod.start }}",
		  {%- assign performingSiteRefOrg = null -%}
		  {%- assign performingSiteTypeOrg =  entry.performer | where: "type", "Organization" | first -%}
		  {% if performingSiteTypeOrg == nil %}
            {% for performer in entry.performer %}
		      {%- assign refPrefix = performer.reference | slice: 0, 12 | downcase -%}
			  {% if refPrefix == "organization" %}
		   	    {% assign performingSiteRefOrg = performer %}
				{% break %}
			  {% endif %}
			{% endfor %}
		  {% endif %}
		  "performingSite": {
		    {% if performingSiteTypeOrg %}
			  "codings": [
		    	{
				  {% include '_codableconcept' coding: performingSiteTypeOrg -%}
				}
			  ],
			  "text": "{% include 'json_escape' value: performingSiteTypeOrg.display | default: performingSiteTypeOrg.code %}"
		    {% elsif performingSiteRefOrg %}
			  "codings": [
		    	{
				  {% include '_codableconcept' coding: performingSiteRefOrg -%}
				}
			  ],
			  "text": "{% include 'json_escape' value: performingSiteRefOrg.display | default: performingSiteRefOrg.code %}"
			{% endif %}
		  },
		  "referenceRange": "{{ entry.referenceRange[0].text }}",
		  "interpretation": {
			"codings": [
		      {% for coding in entry.interpretation[0].coding %}
		    	{
				  {% include '_codableconcept' coding: coding -%}
				},
			  {% endfor %}
			],
			{% assign interpretationText = entry.interpretation[0].text | default: entry.interpretation[0].coding[0].display | default: entry.interpretation[0].coding[0].code %}
			"text": "{% include 'json_escape' value: interpretationText %}"
		  },
		  "resultStatus": {
			"codings": [
			  {
				"system": "http://hl7.org/fhir/ValueSet/observation-status",
				"code": "{{ entry.status }}",
				"display": "{{ entry.status | capitalize }}"      
			  }
			],
			"text": "{{ entry.status | capitalize }}"
		  },
		  {% include '_resultValue' component: entry %}
		  {% if specimens.size > 0 %}
		    {% include '_specimen' specimenReference: entry.specimen.reference %}
		  {% endif %}
		},
      {% endif %}
    {% endif %}
  {% endfor %}
],