"goals": [
  {% for goal in goals %}
    {
	  "goal": {
	  "codings": [
	   {% for coding in goal.description.coding %}
          {
            {% include '_codableconcept' coding: coding -%}
          },
       {% endfor %}
	],
	"text": "{% include 'json_escape' value: goal.description.text | default: goal.description.coding[0].code | default: goal.description.coding[0].display %}"
	},
	"effectiveDate": "{{goal.statusDate | default: goal.startDate | default: goal.startDateTime}}",
	"goalPriority": "{{ goal.priority.text | default: goal.priority.coding[0].code | default: goal.priority.coding[0].display }}",
      {% if goal.lifecycleStatus %}
      "goalStatus": "{{ goal.lifecycleStatus }}",
      {% endif %}
      {% if goal.achievementStatus %}
      "achievementStatus": {
        "codings": [
          {% for coding in goal.achievementStatus.coding %}
          {
            {% include '_codableconcept' coding: coding -%}
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        "text": "{{ goal.achievementStatus.text | default: goal.achievementStatus.coding[0].code | default: goal.achievementStatus.coding[0].display }}"
      },
      {% endif %}
      {% if goal.category %}
      "goalCategory": {
        "codings": [
          {% for coding in goal.category[0].coding %}
            {
              {% include '_codableconcept' coding: coding -%}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
        "text": "{{ goal.category[0].text | default: goal.category[0].coding[0].code | default: goal.category[0].coding[0].display }}"
      },
      {% endif %}
      {% if goal.description %}
      "description": "{% include 'json_escape' value: goal.description.text %}",
      {% endif %}
      {% if goal.startDate %}
      "startDate": "{{ goal.startDate }}",
      {% endif %}
      {% assign dueDateTarget = goal.target | where: "dueDate" | first %}
      "dueDate": "{% include 'json_escape' value: dueDateTarget.dueDate %}",
    },
  {% endfor %}
],