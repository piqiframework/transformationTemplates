{% assign specFound = false %}
 
    {% for specimen in specimens %}
      {% assign specID = specimen.id %}
      {% assign specRef1 = "Specimen/" | append: specID %}
      {% assign specRef2 = "urn:uuid:" | append: specID %}
	  {% if specimenReference == specRef1 or specimenReference == specRef2 or specimenReference == specID %}
        {% if specFound == false %}
		  {% if specimen.type %}
			"specimenType": {
			  "codings": [
				{% for coding in specimen.type.coding %}
				  {
					{% include '_codableconcept' coding: coding -%}
				  }{% unless forloop.last %},{% endunless %}
				{% endfor %}
			  ],
			  {% assign typeText = specimen.type.text | default: specimen.type.coding[0].display | default: specimen.type.coding[0].code %}
			  "text": "{{ typeText }}"
			},
		  {% endif %}
		  {% if specimen.id %}
			"specimenIdentifier": "{{ specID }}",
		  {% endif %}
		  {% if specimen.status %}
			"specimenStatus": "{{ specimen.status | capitalize }}",
		  {% endif %}
		  {% assign collectionDate = specimen.collection.collectedDateTime | default: specimen.collection.collectedPeriod.start %}
		  {% if collectionDate %}
			"specimenCollectionDateTime": "{{ collectionDate }}",
		  {% endif %}
		  {% if specimen.receivedTime %}
			"specimenReceivedTime": "{{ specimen.receivedTime }}",
		  {% endif %}
		  {% if specimen.condition and specimen.condition.size > 0 %}
		    {% assign firstCondition = specimen.condition[0] %}
			"specimenCondition": {
			  "codings": [
				{% for coding in firstCondition.coding %}
				  {
					{% include '_codableconcept' coding: coding -%}
				  }{% unless forloop.last %},{% endunless %}
				{% endfor %}
			  ],
			  {% assign conditionText = firstCondition.text | default: firstCondition.coding[0].display | default: firstCondition.coding[0].code %}
              "text": "{% include 'json_escape' value: conditionText %}"
			},
		  {% endif %}
		  {% if specimen.collection.bodySite %}
			"specimenSourceSite": {
			  "codings": [
				{% for coding in specimen.collection.bodySite.coding %}
				  {
					{% include '_codableconcept' coding: coding -%}
				  }{% unless forloop.last %},{% endunless %}
				{% endfor %}
			  ],
			  {% assign bodySiteText = specimen.collection.bodySite.text | default: specimen.collection.bodySite.coding[0].display | default: specimen.collection.bodySite.coding[0].code %}
              "text": "{% include 'json_escape' value: bodySiteText %}"
			},
		  {% endif %}
          {% assign specFound = true %}
        {% endif %}
      {% endif %}
  {% endfor %}