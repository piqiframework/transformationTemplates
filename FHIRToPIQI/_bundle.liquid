  {% endif %}

  {% if goals.size > 0 %},
  {% include '_goal' goals: goals -%}
  {% endif %}

  {% if observations.size > 0 %},
  {% include '_observation' observations: observations reports: reports specimens: specimens questionnaireResponses: questionnaireResponses -%}
  {% endif %}

  {% if practitioners.size > 0 %},
  {% include '_practitioner' practitioners: practitioners practitionerRoles: practitionerRoles -%}
  {% endif %}

  {% if provenances.size > 0 %},
  {% include '_provenance' provenances: provenances -%}
  {% endif %}

  {% if encounters.size > 0 %},
  {% include '_encounter' encounters: encounters conditions: conditions -%}
  {% endif %}

  {% if medRequests.size > 0 or medStatements.size > 0 or medications.size > 0 or medAdmin.size > 0 or medDispense.size > 0 %},
  "medications": [
    {%- assign medComma = false -%}
    
    {%- comment -%} MedicationRequests {%- endcomment -%}
    {% for med in medRequests %}
      {% if medComma %},{% endif %}
      {% include '_medication' med: med type: "MedicationRequest" refs: medications -%}
      {% assign medComma = true %}
    {% endfor %}
    
    {%- comment -%} MedicationStatements {%- endcomment -%}
    {% for med in medStatements %}
      {% if medComma %},{% endif %}
      {% include '_medication' med: med type: "MedicationStatement" refs: medications -%}
      {% assign medComma = true %}
    {% endfor %}
    
    {%- comment -%} MedicationAdministration {%- endcomment -%}
    {% for med in medAdmin %}
      {% if medComma %},{% endif %}
      {% include '_medication' med: med type: "MedicationAdministration" refs: medications -%}
      {% assign medComma = true %}
    {% endfor %}
    
    {%- comment -%} MedicationDispense {%- endcomment -%}
    {% for med in medDispense %}
      {% if medComma %},{% endif %}
      {% include '_medication' med: med type: "MedicationDispense" refs: medications -%}
      {% assign medComma = true %}
    {% endfor %}
    
    {% for med in medications %}
      {% assign fullUrl = "urn:uuid:" | append: med.id %}
      {% assign shortRef = "Medication/" | append: med.id %}
      {% assign idOnly = med.id %}
      
      {% assign isReferenced = false %}
      
      {% for req in medRequests %}
        {% if req.medicationReference.reference == fullUrl or req.medicationReference.reference == shortRef or req.medicationReference.reference == idOnly %}
          {% assign isReferenced = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% unless isReferenced %}
        {% for stmt in medStatements %}
          {% if stmt.medicationReference.reference == fullUrl or stmt.medicationReference.reference == shortRef or stmt.medicationReference.reference == idOnly %}
            {% assign isReferenced = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}

      {% unless isReferenced %}
        {% for admin in medAdmin %}
          {% if admin.medicationReference.reference == fullUrl or admin.medicationReference.reference == shortRef or admin.medicationReference.reference == idOnly %}
            {% assign isReferenced = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}

      {% unless isReferenced %}
        {% for disp in medDispense %}
          {% if disp.medicationReference.reference == fullUrl or disp.medicationReference.reference == shortRef or disp.medicationReference.reference == idOnly %}
            {% assign isReferenced = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endunless %}

      {% unless isReferenced %}
        {% if medComma %},{% endif %}
        {% include '_medication' med: med type: "Medication" -%}
        {% assign medComma = true %}
      {% endunless %}
    {% endfor %}
  ]
  {% endif %}
