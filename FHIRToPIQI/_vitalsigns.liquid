"vitalSigns":[
{% for observation in observations %}
{% if observation.category[0].coding[0].code == "vital-signs" -%}
  {% if observation.component %}
    {% for component in observation.component %}
    {
      "vitalsign": {
        "codings": [
          {% for coding in component.code.coding %}
          {
            {% include '_codableconcept' coding: coding -%}
          },
          {% endfor %}
        ],
        {% assign compText = component.code.text | default: component.code.coding[0].display | default: component.code.coding[0].code %}
        "text": "{% include 'json_escape' value: compText %}"
      },
      {% if component.dataAbsentReason %}
      "dataAbsentReason": {
        "codings": [
          {% for coding in component.dataAbsentReason.coding %}
            {
		      {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {%- assign categoryText = component.dataAbsentReason.text | default: component.dataAbsentReason.coding[0].display | default: component.dataAbsentReason.coding[0].code -%}
        "text": "{% include 'json_escape' value: categoryText %}"
      },
      {% else %}
      "dataAbsentReason": {
        "codings": [
          {% for coding in observation.dataAbsentReason.coding %}
            {
		      {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {%- assign categoryText = observation.dataAbsentReason.text | default: observation.dataAbsentReason.coding[0].display | default: observation.dataAbsentReason.coding[0].code -%}
        "text": "{% include 'json_escape' value: categoryText %}"
      },
      {% endif %}
      "vitalSignCategory": {
        "codings": [
          {% for coding in observation.category[0].coding %}
            {
		      {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {%- assign categoryText = observation.category[0].text | default: observation.category[0].coding[0].display | default: observation.category[0].coding[0].code -%}
        "text": "{% include 'json_escape' value: categoryText %}"
      },
      "issuedDateTime": "{{ observation.issued }}",
      "performedDateTime": "{{ observation.effectiveDateTime ?? observation.effectivePeriod?.start }}",
	  "performingSite": "{{ observation.performer[0].display }}",
      "interpretation": {
	    "codings": [
		  {% for coding in observation.interpretation[0].coding %}
			{
			  {% include '_codableconcept' coding: coding -%}
			},
		  {% endfor %}
		],
		{% assign interpretationText = observation.interpretation[0].text | default: observation.interpretation[0].coding[0].display | default: observation.interpretation[0].coding[0].code %}
	    "text": "{% include 'json_escape' value: interpretationText %}"
	  },
      "resultStatus": {
		"codings": [
		  {
			"system": "http://hl7.org/fhir/ValueSet/observation-status",
			"code": "{{ observation.status }}",
			"display": "{{ observation.status | capitalize }}"      
		  }
		],
		"text": "{{ observation.status | capitalize }}"
	  },
      {% include '_resultValue' component: component -%}
	},
    {% endfor %}
  {% else %}
  {
   "vitalsign": {
    "codings": [
      {% for coding in observation.code.coding %}
      {
        {% include '_codableconcept' coding: coding -%}
      },
      {% endfor %}
    ],
    {% assign textValue = observation.code.text | default: observation.code.coding[0].display | default: observation.code.coding[0].code %}
    "text": "{% include 'json_escape' value: textValue %}"
  },
  "dataAbsentReason": {
    "codings": [
      {% for coding in observation.dataAbsentReason.coding %}
        {
		  {% include '_codableconcept' coding: coding -%}
        },
      {% endfor %}
    ],
    {%- assign categoryText = observation.dataAbsentReason.text | default: observation.dataAbsentReason.coding[0].display | default: observation.dataAbsentReason.coding[0].code -%}
    "text": "{% include 'json_escape' value: categoryText %}"
  },
  "vitalSignCategory": {
    "codings": [
      {% for coding in observation.category[0].coding %}
        {
		  {% include '_codableconcept' coding: coding -%}
        },
      {% endfor %}
    ],
    {%- assign categoryText = observation.category[0].text | default: observation.category[0].coding[0].display | default: observation.category[0].coding[0].code -%}
    "text": "{% include 'json_escape' value: categoryText %}"
  },
  "performedDateTime": "{{ observation.effectiveDateTime ?? observation.effectivePeriod?.start }}",
  "performingSite": "{{ observation.performer[0].display }}",
  "referenceRange": "{{ observation.referenceRange[0].text }}",
  "interpretation": {
	"codings": [
	  {% for coding in observation.interpretation[0].coding %}
		{
		  {% include '_codableconcept' coding: coding -%}
		},
	  {% endfor %}
	],
	{% assign interpretationText = observation.interpretation[0].text | default: observation.interpretation[0].coding[0].display | default: observation.interpretation[0].coding[0].code %}
	"text": "{% include 'json_escape' value: interpretationText %}"
  },
  "resultStatus": {
    "codings": [
	  {
	    "system": "http://hl7.org/fhir/ValueSet/observation-status",
		"code": "{{ observation.status }}",
		"display": "{{ observation.status | capitalize }}"      
	  }
	],
	"text": "{{ observation.status | capitalize }}"
  },
  {% include '_resultValue' component: observation -%}
},
{% endif %}
{% endif %}
{% endfor %}
],