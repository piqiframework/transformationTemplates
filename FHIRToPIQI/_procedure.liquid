"procedures":[
{% for proc in procedures %}
{
    "procedure": {
      {% if proc.code.coding %}
      "codings": [
        {% for c in proc.code.coding %}
        {
		  {% include '_codableconcept' coding: c -%}
        }{% if forloop.last == false %},{% endif %}
        {% endfor %}
      ],
      {% endif %}
      "text": "{% include 'json_escape' value: proc.code.text | default: proc.code.coding[0].code | default: proc.code.coding[0].display %}"
    },

    "procedureDateTime": "{% if proc.performedDateTime %}{{ proc.performedDateTime }}{% elsif proc.performedPeriod.start %}{{ proc.performedPeriod.start }}{% endif %}",
    "procedurePerformedDate": "{% if proc.performedDateTime %}{{ proc.performedDateTime }}{% elsif proc.performedPeriod.start %}{{ proc.performedPeriod.start }}{% endif %}",
    "procedureStartDatetime": "{% if proc.performedDateTime %}{{ proc.performedDateTime }}{% elsif proc.performedPeriod.start %}{{ proc.performedPeriod.start }}{% endif %}",
    "procedureEndDatetime": "{% if proc.performedPeriod.end %}{{ proc.performedPeriod.end }}{% endif %}",
    {% if proc.status %}
    "procedureStatus": {
      "codings": [
        {
          "system": "http://hl7.org/fhir/event-status",
          "code": "{{ proc.status }}",
          "display": "{{ proc.status | capitalize }}"
        }
      ],
      "text": "{{ proc.status }}"
    },
    {% endif %}

    "procedureReason": {
      {% if proc.reasonCode[0].coding %}
      "codings": [
        {% for r in proc.reasonCode[0].coding %}
        {
          {% include '_codableconcept' coding: r -%}
        }{% if forloop.last == false %},{% endif %}
        {% endfor %}
      ],
      {% endif %}
      "text":  "{% include 'json_escape' value: proc.reasonCode[0].text | default: proc.reasonCode[0].coding[0].code | default: proc.reasonCode[0].coding[0].display %}"
    }
},
{% endfor %}
],
