"demographics": {
  {% assign identifier = patient.identifier | first %}
  "patientIdentifier": "{{ identifier.value }}",
  "firstName": "{% include 'json_escape' value: msg.name[0].given[0] %}",
  "middleName": "{% include 'json_escape' value: msg.name[0].given[1] %}",
  "lastName": "{% include 'json_escape' value: msg.name[0].family %}",
  {% assign telecom = msg.telecom | where: "value" | first %}
  "telecom": "{% include 'json_escape' value: telecom.value %}",
  {% assign email = msg.telecom | where: "system", "email" | first %}
  "emailAddress": "{% include 'json_escape' value: email.value %}",
  {% if msg.address and msg.address.size > 0 %}
    {% assign first_addr = msg.address | first %}
    {% assign addr_text = first_addr.text %}
    {% if addr_text == nil or addr_text == empty %}
      {% assign addr_text = "" %}
      {% if first_addr.line %}
        {% assign addr_text = first_addr.line | join: " " %}
      {% endif %}
      {% if first_addr.city %}
        {% if addr_text != "" %}
          {% assign addr_text = addr_text | append: ", " %}
        {% endif %}
        {% assign addr_text = addr_text | append: first_addr.city %}
      {% endif %}
      {% if first_addr.state %}
        {% if addr_text != "" %}
          {% assign addr_text = addr_text | append: ", " %}
        {% endif %}
        {% assign addr_text = addr_text | append: first_addr.state %}
      {% endif %}
      {% if first_addr.postalCode %}
        {% if addr_text != "" %}
          {% assign addr_text = addr_text | append: ", " %}
        {% endif %}
        {% assign addr_text = addr_text | append: first_addr.postalCode %}
      {% endif %}
      {% if first_addr.country %}
        {% if addr_text != "" %}
          {% assign addr_text = addr_text | append: ", " %}
        {% endif %}
        {% assign addr_text = addr_text | append: first_addr.country %}
      {% endif %}
    {% endif %}
    "currentAddress": "{% include 'json_escape' value: addr_text %}",
  {% endif %}
  "birthSex": {
  {% assign birth_sex_ext = msg.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-birthsex" | first %}
  {% if birth_sex_ext == nil or birth_sex_ext == empty %}
  "codings": [
    {
	  "system": "http://hl7.org/fhir/administrative-gender",
      "code": "{{ msg.gender }}",
	  "display": "{{ msg.gender | capitalize }}"
    }
  ],
  "text": "{{ msg.gender | capitalize }}"
  {% else %}
  {% assign birth_sex_code = birth_sex_ext.valueCode %}
  {% assign birth_sex_text = "" %}
  {% if birth_sex_code == "M" %}
    {% assign birth_sex_text = "Male" %}
  {% elsif birth_sex_code == "F" %}
	{% assign birth_sex_text = "Female" %}
  {% elsif birth_sex_code == "UNK" %}
	{% assign birth_sex_text = "Unknown" %}
  {% else %}
	{% assign birth_sex_text = "Other" %}
  {% endif %}
    "codings": [
    {
	  "system": "http://hl7.org/fhir/us/core/CodeSystem/birthsex",
      "code": "{{ birth_sex_code }}",
	  "display": "{{ birth_sex_text }}"
    }
    ],
    "text": "{{ birth_sex_text }}"
  {% endif %}
  },
	"birthDate": "{{ msg.birthDate }}",
	{% if msg.deceasedDateTime %}
    "deceased": true,
	{% endif %}
	"deathDate": "{{ msg.deceasedDateTime }}",
    "ethnicity": {
      {% assign ethnicity_ext = msg.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-ethnicity" | first %}
      {% if ethnicity_ext.extension %}
        "codings": [
          {% for subext in ethnicity_ext.extension %}
            {% if subext.url == "ombCategory" %}
              {
                {% include '_valuecodableconcept' coding: subext -%}
              },
            {% endif %}
          {% endfor %}
        ],
		{% assign text_ext = ethnicity_ext.extension | where: "url", "text" | first %}
        "text": "{% include 'json_escape' value: text_ext.valueString %}"
      {% endif %}
    },
    "genderIdentity": {
      {% assign gender_ext = msg.extension | where: "url", "http://hl7.org/fhir/StructureDefinition/patient-genderIdentity" | first %}
      {% if gender_ext.valueCodeableConcept %}
        "codings": [
          {% for coding in gender_ext.valueCodeableConcept.coding %}
            {
              {% include '_valuecodableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {% assign genderText = gender_ext.valueCodeableConcept.text | default: gender_ext.valueCodeableConcept.coding[0].display | default: gender_ext.valueCodeableConcept.coding[0].code %}
        "text": "{{ genderText }}"
      {% endif %}
    },
    "maritalStatus": {
      {% if msg.maritalStatus %}
        "codings": [
          {% for coding in msg.maritalStatus.coding %}
            {
			  {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {% assign maritalText = msg.maritalStatus.text | default: msg.maritalStatus.coding[0].display | default: msg.maritalStatus.coding[0].code %}
        "text": "{{ maritalText }}"
      {% endif %}
    },
    "primaryLanguage": {
      {% assign lang_ext = msg.communication[0].language %}
      {% if lang_ext %}
        "codings": [
          {% for coding in lang_ext.coding %}
            {
			  {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {% assign langText = lang_ext.text | default: lang_ext.coding[0].display | default: lang_ext.coding[0].code %}
        "text": "{{ langText }}"
      {% endif %}
    },
    "race": {
      {% assign race_ext = msg.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-race" | first %}
      {% if race_ext.extension %}
        "codings": [
          {% for subext in race_ext.extension %}
            {% if subext.url == "ombCategory" %}
              {
			    {% include '_valuecodableconcept' coding: subext -%}
              },
            {% endif %}
          {% endfor %}
        ],
		{% assign race_text = race_ext.extension | where: "url", "text" | first %}
        "text": "{{ race_text.valueString }}"
      {% endif %}
    },
    {% for obs in observations %}
      {% if obs.meta.profile contains "http://hl7.org/fhir/us/core/StructureDefinition/us-core-observation-sexual-orientation" %}
        "sexualOrientation": {
          "codings": [
            {% for coding in obs.valueCodeableConcept.coding %}
              {
                {% include '_codableconcept' coding: coding -%}
              },
            {% endfor %}
          ],
          {% assign orientationText = obs.valueCodeableConcept.text | default: obs.valueCodeableConcept.coding[0].display | default: obs.valueCodeableConcept.coding[0].code %}
          "text": "{{ orientationText }}"
        },
        {% break %}
      {% endif %}
    {% endfor %}
    {% assign tribalExt = msg.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-tribal-affiliation" | first  %}
    {% assign tribalCCExt = tribalExt.extension | where: "url", "tribalAffiliation" | first  %}
    "tribalAffiliation": {
        "codings": [
          {% for coding in tribalCCExt.valueCodeableConcept.coding %}
            {
              {% include '_codableconcept' coding: coding -%}
            },
          {% endfor %}
        ],
        {% assign tribalText = tribalCCExt.valueCodeableConcept.text | default: tribalCCExt.valueCodeableConcept.coding[0].display | default: tribalCCExt.valueCodeableConcept.coding[0].code %}
        "text": "{{ tribalText }}"
    }
},