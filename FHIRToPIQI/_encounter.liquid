"encounters":[
{% for encounter in encounters %}
{% assign encounterId = encounter.id %}
{% assign encounterRef1 = "Encounter/" | append: encounterId %}
{% assign encounterRef2 = "urn:uuid:" | append: encounterId %}
{
  "encounterDateTime": "{{ encounter.period.start }}",
  "encounterDisposition": "{% if encounter.hospitalization and encounter.hospitalization.dischargeDisposition and encounter.hospitalization.dischargeDisposition.text %}{{ encounter.hospitalization.dischargeDisposition.text }}{% endif %}",
  "encounterIdentifier": "{% if encounter.identifier and encounter.identifier.size > 0 %}{{ encounter.identifier.first.value }}{% endif %}",
  "encounterIdentifierNamespace": "{% if encounter.identifier and encounter.identifier.size > 0 %}{{ encounter.identifier.first.system }}{% endif %}",
      
  "encounterLocation": "{% if encounter.location and encounter.location.size > 0 %}{{ encounter.location.first.location.display | default: encounter.location.first.location.reference }}{% endif %}",

  "encounterType": {
    "codings": [
      {% for coding in encounter.type[0].coding %}
        {
          {% include '_codableconcept' coding: coding -%}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "text": "{{ encounter.type[0].text | default: encounter.type[0].coding[0].code | default: encounter.type[0].coding[0].display }}"
  },

  "encounterStatus": {
    "codings": [
      {
        "system": "http://hl7.org/fhir/ValueSet/encounter-status",
        "code": "{% include 'json_escape' value: encounter.status %}",
        "display": "{% include 'json_escape' value: encounter.status %}"
      }
    ],
    "text": "{% include 'json_escape' value: encounter.status %}"
  },

  {% if encounter.class and encounter.class.display %}
  "class": "{{ encounter.class.display }}",
  {% endif %}

  "encounterClass": { 
    {% if encounter.class[0] %}
      {% for coding in encounter.class[0].coding %}
        "codings": [
          {
            {% include '_codableconcept' coding: coding -%}
          },
        ],
        {% assign textValue = encounter.class[0].text | default: encounter.class[0].coding[0].code | default: encounter.class[0].coding[0].display  %}
        "text": "{% include 'json_escape' value: textValue %}"
      {% endfor %}
    {% elsif encounter.class %}
      "codings": [
        {
          {% include '_codableconcept' coding: encounter.class -%}
        },
      ],
      {% assign textValue = default: encounter.class.code | default: encounter.class.display  %}
      "text": "{% include 'json_escape' value: textValue %}"
    {% endif %}
  },

  {% if encounter.period.start %}
    "encounterStartDatetime": "{{ encounter.period.start }}",
  {% endif %} 

  {% if encounter.period.end %}
    "encounterEndDatetime": "{{ encounter.period.end }}",
  {% endif %}

  {% if encounter.diagnosis %}
  "encounterDiagnosis": {
    "codings": [
    {% assign diag = encounter.diagnosis[0] %}
    {% for coding in diag.use.coding %}
    {
       {% include '_codableconcept' coding: coding -%}
    },
    {% endfor %}
    ],
    {% assign textValue = diag.use.text | default: diag.use.coding[0].code | default: diag.use.coding[0].display  %}
    "text": "{% include 'json_escape' value: textValue %}"
  },
  {% else %}
  {% assign condFound = false %}
 
  {% for cond in conditions %}
  {% if cond.encounter.reference == encounterRef1 or cond.encounter.reference == encounterRef2 %}
  {% if condFound == false and cond.category and cond.category[0].coding and cond.category[0].coding[0].code == "encounter-diagnosis" %}
        "encounterDiagnosis": {
          "codings": [
            {% for coding in cond.code.coding %}
            {
               {% include '_codableconcept' coding: coding -%}
            },
            {% endfor %}
          ],
          {% assign textValue = cond.code.text | default: cond.code.coding[0].code | default: cond.code.coding[0].display  %}
          "text": "{% include 'json_escape' value: textValue %}"
        },
        {% assign condFound = true %}
  {% endif %}
  {% endif %}
  {% endfor %}
  {% endif %}

  {% if encounter.reasonCode %}
   "encounterReason": {
    "codings": [
      {% for rc in encounter.reasonCode %}
        {% for coding in rc.coding %}
        {
           {% include '_codableconcept' coding: coding -%}
        },
        {% endfor %}
      {% endfor %}
    ],
     {% assign textValue = encounter.reasonCode[0].text | default: encounter.reasonCode[0].coding[0].code | default: encounter.reasonCode[0].coding[0].display  %}
    "text": "{% include 'json_escape' value: textValue %}"
  },
  {% endif %}
},
{% endfor %}
],