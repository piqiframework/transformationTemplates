"immunizations":[
{% for immunization in immunizations %}
{
  "administrationDate": "{{ immunization.occurrenceDateTime }}",
  "expirationDate": "{{ immunization.expirationDate }}",
  "lotNumber": "{{ immunization.lotNumber }}",
  "primarySource": {{ immunization.primarySource }},
  "reaction": {
	"codings": [
	  {% for reaction in immunization.reaction %}
		{% if reaction.detail.display %}
		{
		  "display": "{% include 'json_escape' value: reaction.detail.display %}"
		}{% unless forloop.last %},{% endunless %}
		{% endif %}
	  {% endfor %}
	],
	"text": "{% include 'json_escape' value:  immunization.reaction[0].detail.display %}"
  },
  "immunization": {
	"codings": [
	  {% for coding in immunization.vaccineCode.coding %}
	  {
		{% include '_codableconcept' coding: coding -%}
	  }{% unless forloop.last %},{% endunless %}
	  {% endfor %}
	],
	"text": "{% include 'json_escape' value: immunization.vaccineCode.text | default: immunization.vaccineCode.coding[0].code | default: immunization.vaccineCode.coding[0].display %}"
  },
  "immunizationStatus": {
    "codings": [
      {
        "system": "http://hl7.org/fhir/event-status",
        "code": "{{ immunization.status }}",
        "display": "{{ immunization.status | capitalize }}"      
      }
    ],
    "text": "{{ immunization.status }}"
  },
  "immunizationStatusReason": {
    "codings": [
      {% for coding in immunization.statusReason.coding %}
        {
          {% include '_codableconcept' coding: coding -%}
        },
      {% endfor %}
    ],
    {%- assign reasonText =  immunization.statusReason.text | default: immunization.statusReason.coding[0].code | default: immunization.statusReason.coding[0].display -%}
    "text": "{% include 'json_escape' value: reasonText %}"
  },
},
{% endfor %}
],
