"clinicalDocuments": [
{% for doc in docs %}
{
  "documentIdentifier": "{{ doc.identifier[0].value }}",
  "effectiveDate": "{{ doc.date }}",
  "documentPeriodStart": "{{ doc.period.start }}",
  "documentPeriodEnd": "{{ doc.period.end }}",
  "hasAttachment": {% if doc.content and doc.content.size > 0 %}true{% else %}false{% endif %},
  "documentAuthorIdentifier": "{{ doc.author[0].reference }}",
  "documentAuthorName": "{{ doc.author[0].display }}",
  "documentTitle": "{% include 'json_escape' value: doc.description %}",
  {% if doc.type %}
  "documentType": {
	"codings": [
	  {% for coding in doc.type.coding %}
	  {
		{% include '_codableconcept' coding: coding -%}
	  },
	  {% endfor %}
	],
	{%- assign docTypeText = doc.type.text | default: doc.type.coding[0].code | default: doc.type.coding[0].display -%}
	"text": "{% include 'json_escape' value: docTypeText %}"
  },
  {% endif %}
  "documentFormat": {
    "codings": [
      {
		{% include '_codableconcept' coding: doc.content[0].format -%}
      }
    ],
    "text": "{{ doc.content[0].format.code | default: doc.content[0].format.display }}"
  },
  {% if doc.category[0] %}
  "documentCategory": 
	{
	  "codings": [
		{% for coding in doc.category[0].coding %}
		{
		  {% include '_codableconcept' coding: coding -%}
		},
		{% endfor %}
	  ],
	  {%- assign catText = doc.category[0].text | default: doc.category[0].coding[0].code | default: doc.category[0].coding[0].display -%}
	  "text": "{% include 'json_escape' value: catText %}"
	},
  {% endif %}
  "documentStatus": {
	"codings": [
	  {
        "system": "http://hl7.org/fhir/ValueSet/composition-status",
        "code": "{{ doc.status }}",
        "display": "{{ doc.status }}"
      }
	],
	"text": "{{ doc.status }}"
  },
},
{% endfor %}
],