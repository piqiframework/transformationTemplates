"carePlan": [
  {% for plan in careplans %}
    {
      "planStatus": {
        "codings": [
          {
            "system": "http://hl7.org/fhir/ValueSet/request-status",
            "code": "{{ plan.status }}",
            "display": "{{ plan.status }}"
          }
        ],
        "text": "{{ plan.status }}"
      },
      "planIntent": {
        "codings": [
          {
            "system": "http://hl7.org/fhir/ValueSet/care-plan-intent",
            "code": "{{ plan.intent }}",
            "display": "{{ plan.intent }}"
          }
        ],
        "text": "{{ plan.intent }}"
      },
      {% if plan.category[0] %}
      "planCategory": 
        {
          "codings": [
            {% for coding in plan.category[0].coding %}
            {
              {% include '_codableconcept' coding: coding -%}
            },
            {% endfor %}
          ],
          {%- assign catText = plan.category[0].text | default: plan.category[0].coding[0].display | default: plan.category[0].coding[0].code -%}
          "text": "{% include 'json_escape' value: catText %}"
        },
      {% endif %}
      "planNarrative": "{% include 'json_escape' value: plan.text.div %}",
      "planNarrativeStatus": {"text": "{% include 'json_escape' value: plan.text.status %}"},
      {% if plan.title %}
       "title": "{% include 'json_escape' value: plan.title %}",
      {% endif %}
      {% if plan.description %}
      "description": "{% include 'json_escape' value: plan.description %}",
      {% endif %}

      {% assign effectiveDate = plan.period.start | default: plan.created | default: plan.period.end  %}
      "effectiveDate": "{% include 'json_escape' value: effectiveDate %}",

      {% if plan.subject %}
      "subject": {
        "reference": "{{ plan.subject.reference }}",
        "display": "{% include 'json_escape' value: plan.subject.display %}"
      },
      {% endif %}
      {% if plan.author %}
      "author": {
        "reference": "{{ plan.author.reference }}",
        "display": "{{ plan.author.display }}"
      },
      {% endif %}
    },
  {% endfor %}
],