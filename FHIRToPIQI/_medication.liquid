{
  {% assign ref_found = false %}
  {% assign med_resource = null %}
  {% if med.medicationReference %}
	{% for ref in refs %}
      {% assign med1 = "Medication/" | append: ref.id %}
      {% assign med2 = "urn:uuid:" | append: ref.id %}
      {% if med.medicationReference.reference == med1 or med.medicationReference.reference == med2 %}
		{% assign ref_found = true %}
        {% assign med_resource = ref %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}


    "medication": {
	  {% comment %} Try to resolve medicationReference {% endcomment %}
	  {% if ref_found and med_resource %}
		{% if med_resource.identifier and med_resource.identifier.size > 0 %}
		  "identifier": [
		    {% for ident in med_resource.identifier %}
		      {
		        "system": "{{ ident.system }}",
		        "value": "{{ ident.value }}"
		      }, 
		    {% endfor %}
		  ],
		{% endif %}
		"codings": [
		  {% for refCode in med_resource.code.coding %}
		    {
			  {% include '_codableconcept' coding: refCode -%}
		    },
		  {% endfor %}
		],
        {% assign textValue = med_resource.code.text | default: med_resource.code.coding[0].code | default: med_resource.code.coding[0].display %}
		"text": "{% include 'json_escape' value: textValue %}",
	  {% else %}
	    {% if med.medicationReference.identifier %}
	      {% assign ident = med.medicationReference.identifier %}
	      {% if ident.system and ident.value %}
	        "codings": [
	          {
	            "system": "{{ ident.system }}",
	            "code": "{{ ident.value }}",
	            "display": "{{ med.medicationReference.display }}"
	          }
	        ],
	        "text": "{% include 'json_escape' value: med.medicationReference.display %}",
	      {% endif %}
	    {% elsif med.medicationReference.display %}
	      "text": "{% include 'json_escape' value: med.medicationReference.display %}",
	    {% endif %}
	  {% endif %}
	  {% if med.medicationCodeableConcept.coding %}
        "codings": [
          {% for code in med.medicationCodeableConcept.coding %}
            {
			  {% include '_codableconcept' coding: code -%}
            },
          {% endfor %}
        ],
        {% assign textValue = med.medicationCodeableConcept.text | default: med.medicationCodeableConcept.coding[0].code | default: med.medicationCodeableConcept.coding[0].display %}
        "text": "{% include 'json_escape' value: textValue %}"
	  {% endif %}
	  {% if med.code %}
        "codings": [
          {% for code in med.code.coding %}
            {
			  {% include '_codableconcept' coding: code -%}
            },
          {% endfor %}
        ],
        {% assign textValue = med.code.text | default: med.code.coding[0].code | default: med.code.coding[0].display %}
        "text": "{% include 'json_escape' value: textValue %}"
	  {% endif %}
    },
	"medicationCategory": {
      "codings": [
        {% for coding in med.category[0].coding %}
          {
		    {% include '_codableconcept' coding: coding -%}
          },
        {% endfor %}
      ],
      {%- assign medText = med.category[0].text | default: med.category[0].coding[0].code | default: med.category[0].coding[0].display -%}
      "text": "{% include 'json_escape' value: medText %}"
    },
    {% if med.intent %}
    "medicationIntent": {
      "codings": [
        {
          "system": "http://hl7.org/fhir/ValueSet/medicationrequest-intent",
          "code": "{{ med.intent }}",
          "display": "{{ med.intent | capitalize }}"
        },
      ],
      "text": "{{ med.intent }}"
    },
    {% endif %}

    "startDate": "{% if med.dispenseRequest.validityPeriod.start %}{{ med.dispenseRequest.validityPeriod.start }}{% elsif med.effectivePeriod.start %}{{ med.effectivePeriod.start }}{% elsif med.authoredOn %}{{ med.authoredOn }}{% endif %}",
    "endDate": "{% if med.dispenseRequest.validityPeriod.end %}{{ med.dispenseRequest.validityPeriod.end }}{% elsif med.effectivePeriod.end %}{{ med.effectivePeriod.end }}{% endif %}",
    {% if med.dosageInstruction.size >0 %}
	  {% include '_medInstruction' dosage: med.dosageInstruction[0] -%}
	{% elsif med.dosage.size > 0 %}
	  {% include '_medInstruction' dosage: med.dosage[0] -%}
	{%endif %}
	{% if med.dosageInstruction[0].doseAndRate[0].doseQuantity %}
	"doseQuantity": "{% if med.dosageInstruction[0].doseAndRate[0].doseQuantity.value %}{{ med.dosageInstruction[0].doseAndRate[0].doseQuantity.value }}{% endif %}",
    "doseQuantityUnit": {
	  "codings": [
	  {
      {% assign unit = med.dosageInstruction[0].doseAndRate[0].doseQuantity %}
      "system": "{{ unit.system }}",
      "code": "{{ unit.code }}",
      "unit": "{{ unit.unit }}"
	  }
	 ],
	  "text": "{{ unit.unit }}"
    },
    "doseAmount": "{% if med.dosageInstruction[0].doseAndRate[0].doseQuantity.value %}{{ med.dosageInstruction[0].doseAndRate[0].doseQuantity.value }}{% endif %}",
    "doseAmountUnit": {
	  "codings": [
	  {
      "system": "{{ unit.system }}",
      "code": "{{ unit.code }}",
      "unit": "{{ unit.unit }}"
	  }
	 ],
	  "text": "{{ unit.unit }}"
    },
	{% elsif med.dosageInstruction[0].doseQuantity %}
	"doseQuantity": "{% if med.dosageInstruction[0].doseQuantity.value %}{{ med.dosageInstruction[0].doseQuantity.value }}{% endif %}",
    "doseQuantityUnit": {
	  "codings": [
	  {
       {% assign dq = med.dosageInstruction[0].doseQuantity %}
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
    "doseAmount": "{% if med.dosageInstruction[0].doseQuantity.value %}{{ med.dosageInstruction[0].doseQuantity.value }}{% endif %}",
    "doseAmountUnit": {
	  "codings": [
	  {
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
	{% elsif med.dosage.size > 0 and med.dosage[0].doseAndRate[0].doseQuantity %}
	{% assign dq = med.dosage[0].doseAndRate[0].doseQuantity %}
	"doseQuantity": "{{ dq.value }}",
    "doseQuantityUnit": {
	  "codings": [
	  {
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
    "doseAmount": "{{ dq.value }}",
    "doseAmountUnit": {
	  "codings": [
	  {
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
	{% elsif med.dosage.size > 0 and med.dosage[0].doseQuantity %}
	{% assign dq = med.dosage[0].doseQuantity %}
	"doseQuantity": "{{ dq.value }}",
    "doseQuantityUnit": {
	  "codings": [
	  {
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
    "doseAmount": "{{ dq.value }}",
    "doseAmountUnit": {
	  "codings": [
	  {
      "system": "{{ dq.system }}",
      "code": "{{ dq.code }}",
      "unit": "{{ dq.unit }}"
	  }
	 ],
	  "text": "{{ dq.unit }}"
    },
    {%elsif med.dosage.dose %}
	"doseAmount": "{{ med.dosage.dose.value }}",
	"doseAmountUnit": {
	  "codings": [
		{
		  "system": "{{ med.dosage.dose.system | default: 'http://unitsofmeasure.org' }}",
		  "code": "{{ med.dosage.dose.code | default: medicationAdministration.dosage.dose.unit }}",
		  "display": "{{ med.dosage.dose.unit }}"
		}
	  ],
	  "text": "{{ medicationAdministration.dosage.dose.unit }}"
	},
	{% endif %}

	"doseRoute": {
	{%if med.dosageInstruction[0].route %}
      {% assign route = med.dosageInstruction[0].route %}
      "codings": [
        {% for r in route.coding %}
          {
            {% include '_codableconcept' coding: r -%}
          },
        {% endfor %}
      ],
      {% assign routeText = route.text | default: route.coding[0].code | default: route.coding[0].display %}
      "text": "{{ routeText }}"
	  {% elsif med.dosage.size > 0 and med.dosage[0].route %}
	   {% assign route = med.dosage[0].route %}
	   "codings": [
       {% for coding in route.coding %}
        {
		   {% include '_codableconcept' coding: coding -%}
        },
      {% endfor %}
      ],
      {% assign routeText = route.text | default: route.coding[0].code | default: route.coding[0].display %}
      "text": "{{ routeText }}"
	  {% elsif med.dosage.route.coding %}
       "codings": [
       {% for coding in med.dosage.route.coding %}
        {
		   {% include '_codableconcept' coding: coding -%}
        },
      {% endfor %}
      ],
      {% assign routeText = med.dosage.route.text | default: med.dosage.route.coding[0].code | default: med.dosage.route.coding[0].display %}
      "text": "{{ routeText }}"
	  {% endif %}
    },
	
	{% if ref_found and med_resource.status %}
    "fillStatus": {
      "codings": [
        {
          "system": "http://hl7.org/fhir/ValueSet/medication-status",
          "code": "{{ med_resource.status }}",
          "display": "{{ med_resource.status }}"
        }
      ],
      "text": "{{ med_resource.status }}"
    },
    {% elsif type != "MedicationRequest" and med.status %}
      "fillStatus": {
        "codings": [
          {
            "system": "http://hl7.org/fhir/ValueSet/medication-statement-status",
            "code": "{{ med.status }}",
            "display": "{{ med.status }}"
          }
        ],
        "text": "{{ med.status }}"
      },
	{% endif %}
    {% if type == "MedicationRequest" and med.status %}
      "requestStatus": {
        "codings": [
          {
            "system": "http://hl7.org/fhir/ValueSet/medicationrequest-status",
            "code": "{{ med.status }}",
            "display": "{{ med.status }}"
          }
        ],
        "text": "{{ med.status }}"
      },
	{% endif %}
	
    "adherence": {
      {% if med.statusReason.coding %}
        "codings": [
          {% for c in med.statusReason.coding %}
            {
			  {% include '_codableconcept' coding: c -%}
            },
          {% endfor %}
        ],
        {% assign adherenceText = med.statusReason.text | default: med.statusReason.coding[0].code | default: med.statusReason.coding[0].display %}
        "text": "{% include 'json_escape' value: adherenceText %}"
      {% endif %}
    },

    "indication": [
      {% for rc in med.reasonCode %}
        {
          {% if rc.coding %}
            "codings": [
              {% for c in rc.coding %}
                {
			      {% include '_codableconcept' coding: c -%}
                },
              {% endfor %}
            ],
            {% assign indicationText = rc.text | default: rc.coding[0].code | default: rc.coding[0].display %}
            "text":  "{% include 'json_escape' value: indicationText %}"
          {% endif %}
        },
      {% endfor %}
    ],

  {% assign medDate = '' %}

  {% if med.dateAsserted %}
    {% assign medDate = med.dateAsserted %}
  {% elsif med.effectiveDateTime %}
    {% assign medDate = med.effectiveDateTime %}
  {% elsif med.effectivePeriod %}
    {% if med.effectivePeriod.start %}
      {% assign medDate = med.effectivePeriod.start %}
    {% endif %}
  {% elsif med.authoredOn %}
    {% assign medDate = med.authoredOn %}
  {% endif %}
  "statementDate": "{{ medDate }}",
},