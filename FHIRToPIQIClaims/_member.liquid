{% assign eob = eobs | first %}

{% comment %} MEMB_ID / MEMB_UNIQUEID: fall-through EOB.patient identifier then reference string {% endcomment %}
{% assign membId = eob.patient.identifier.value %}
{% unless membId %}
  {% assign membId = eob.patient.reference %}
{% endunless %}

"member": {
    {% comment %} MEMB_ID {% endcomment %}
    {% if membId %}
    "memberId": "{{ membId }}",
    {% endif %}

    {% comment %} MEMB_UNIQUEID {% endcomment %}
    {% if membId %}
    "uniqueMemberId": "{{ membId }}",
    {% endif %}

    {% comment %} Patient-level demographics — populated when Patient resource is available {% endcomment %}
    {% if patient %}

      {% comment %} MEMB_DOB {% endcomment %}
      {% if patient.birthDate %}
      "dateOfBirth": "{{ patient.birthDate }}",
      {% endif %}

      {% comment %} MEMB_DECEASED / MEMB_DOD {% endcomment %}
      {% if patient.deceasedBoolean != null %}
      "deceasedFlag": "{{ patient.deceasedBoolean }}",
      {% endif %}
      {% if patient.deceasedDateTime %}
      "dateOfDeath": "{{ patient.deceasedDateTime }}",
      {% endif %}

      {% comment %} MEMB_ADDRESS / MEMB_CITY / MEMB_STATE / MEMB_POSTCODE / MEMB_COUNTRY / MEMB_COUNTY {% endcomment %}
      {% assign addr = patient.address | first %}
      {% if addr %}
        {% assign streetLine = addr.line | first %}
        {% if streetLine %}
        "streetAddress": "{{ streetLine }}",
        {% endif %}
        {% if addr.city %}
        "city": "{{ addr.city }}",
        {% endif %}
        {% if addr.state %}
        "state": "{{ addr.state }}",
        {% endif %}
        {% if addr.postalCode %}
        "postalCode": "{{ addr.postalCode }}",
        {% endif %}
        {% if addr.country %}
        "country": "{{ addr.country }}",
        {% endif %}
        {% if addr.district %}
        "county": "{{ addr.district }}",
        {% endif %}
        {% comment %} Address period — MEMB_ADDRSTARTDATE / MEMB_ADDRENDDATE {% endcomment %}
        {% if addr.period.start %}
        "addressStartDate": "{{ addr.period.start }}",
        {% endif %}
        {% if addr.period.end %}
        "addressEndDate": "{{ addr.period.end }}",
        {% endif %}
      {% endif %}

      {% comment %} MEMB_BIRTHSEX — CodeableConcept from extension {% endcomment %}
      {% assign birthSexExt = patient.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-birthsex" | first %}
      {% if birthSexExt %}
      "birthSex": {
        "codings": [
          {
            "system": "http://terminology.hl7.org/CodeSystem/v3-AdministrativeGender",
            "code": "{{ birthSexExt.valueCode }}",
            "display": "{{ birthSexExt.valueCode }}"
          }
        ],
        "text": "{{ birthSexExt.valueCode }}"
      },
      {% endif %}

      {% comment %} MEMB_RACE — CodeableConcept from extension {% endcomment %}
      {% assign raceExt = patient.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-race" | first %}
      {% if raceExt %}
        {% assign raceCoding = raceExt.extension | where: "url", "ombCategory" | first %}
        {% if raceCoding %}
        "raceCode": {
          "codings": [
            {
              "system": "{{ raceCoding.valueCoding.system }}",
              "code": "{{ raceCoding.valueCoding.code }}",
              "display": "{{ raceCoding.valueCoding.display | default: raceCoding.valueCoding.code }}"
            }
          ],
          "text": "{{ raceCoding.valueCoding.display | default: raceCoding.valueCoding.code }}"
        },
        {% endif %}
      {% endif %}

      {% comment %} MEMB_ETHNICITY — CodeableConcept from extension {% endcomment %}
      {% assign ethExt = patient.extension | where: "url", "http://hl7.org/fhir/us/core/StructureDefinition/us-core-ethnicity" | first %}
      {% if ethExt %}
        {% assign ethCoding = ethExt.extension | where: "url", "ombCategory" | first %}
        {% if ethCoding %}
        "ethnicity": {
          "codings": [
            {
              "system": "{{ ethCoding.valueCoding.system }}",
              "code": "{{ ethCoding.valueCoding.code }}",
              "display": "{{ ethCoding.valueCoding.display | default: ethCoding.valueCoding.code }}"
            }
          ],
          "text": "{{ ethCoding.valueCoding.display | default: ethCoding.valueCoding.code }}"
        },
        {% endif %}
      {% endif %}

      {% comment %} MEMB_PRIM_LANG — CodeableConcept; prefer preferred=true, fallback to first {% endcomment %}
      {% if patient.communication %}
        {% assign prefLang = patient.communication | where: "preferred", true | first %}
        {% if prefLang %}
          {% assign lang = prefLang %}
        {% else %}
          {% assign lang = patient.communication[0] %}
        {% endif %}
        {% if lang.language %}
        "primaryLanguage": {
          "codings": [
            {% assign langComma = false %}
            {% for coding in lang.language.coding %}
              {% if langComma %},{% endif %}
              {
                "system": "{{ coding.system }}",
                "code": "{{ coding.code }}",
                "display": "{{ coding.display | default: coding.code }}"
              }
              {% assign langComma = true %}
            {% endfor %}
          ],
          "text": "{{ lang.language.text | default: lang.language.coding[0].display | default: lang.language.coding[0].code }}"
        },
        {% endif %}
      {% endif %}

      {% comment %} MEMB_IDTYPE — CodeableConcept from identifier.type {% endcomment %}
      {% assign patIdent = patient.identifier | first %}
      {% if patIdent.type %}
      "memberIdentifierType": {
        "codings": [
          {% assign mitComma = false %}
          {% for coding in patIdent.type.coding %}
            {% if mitComma %},{% endif %}
            {
              "system": "{{ coding.system }}",
              "code": "{{ coding.code }}",
              "display": "{{ coding.display | default: coding.code }}"
            }
            {% assign mitComma = true %}
          {% endfor %}
        ],
        "text": "{{ patIdent.type.text | default: patIdent.type.coding[0].display | default: patIdent.type.coding[0].code }}"
      },
      {% endif %}

      {% comment %} MEMB_TELECOM_SYSTEM / MEMB_TELECOM_USE — CodeableConcept {% endcomment %}
      {% assign telecom = patient.telecom | first %}
      {% if telecom %}
        {% if telecom.system %}
        "telecomSystem": {
          "codings": [
            {
              "system": "http://hl7.org/fhir/contact-point-system",
              "code": "{{ telecom.system }}",
              "display": "{{ telecom.system }}"
            }
          ],
          "text": "{{ telecom.system }}"
        },
        {% endif %}
        {% if telecom.use %}
        "telecomUse": {
          "codings": [
            {
              "system": "http://hl7.org/fhir/contact-point-use",
              "code": "{{ telecom.use }}",
              "display": "{{ telecom.use }}"
            }
          ],
          "text": "{{ telecom.use }}"
        },
        {% endif %}
      {% endif %}

    {% endif %} {% comment %} end if patient {% endcomment %}
  }
